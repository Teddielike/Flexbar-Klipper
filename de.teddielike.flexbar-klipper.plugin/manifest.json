  "local": {
    "de": {
      "PluginName": "Klipper",
      "Keys": {
        "status": {
          "Title": "Druckerstatus",
          "Tip": "Zeigt den Zustand des Druckers (Bereit, Druckt, Pausiert, Fehler, Offline)."
        },
        "job": {
          "Title": "Druckauftrag",
          "Tip": "Aktueller Druck: Name, Fortschritt in %, Restzeit, optional Fertig-um, Layer und Fortschrittsbalken."
        },
        "jobinfo": {
          "Title": "Druck-Einzelwert",
          "Tip": "Ein einzelner Wert des aktuellen Drucks: Fortschritt, Restzeit, Fertig um, Dateiname, Layer, Filament …"
        },
        "hotend": {
          "Title": "Hotend",
          "Tip": "Ist- und Solltemperatur des Hotends (extruder). Optional: eigener G-Code für einfaches und doppeltes Tippen."
        },
        "bed": {
          "Title": "Druckbett",
          "Tip": "Ist- und Solltemperatur der Bauplatte (heater_bed). Optional: eigener G-Code für einfaches und doppeltes Tippen."
        },
        "chamber": {
          "Title": "Bauraum",
          "Tip": "Bauraumtemperatur – wird automatisch erkannt oder frei gewählt. Optional: eigener G-Code für einfaches und doppeltes Tippen."
        },
        "sensor": {
          "Title": "Sensor (frei)",
          "Tip": "Beliebige Klipper-Objekte oder Moonraker-Sensoren, z. B. QIDI Box, Feuchtesensoren, Lüfter, MCU-Temperatur. Optional: eigener G-Code für einfaches und doppeltes Tippen."
        },
        "pause": {
          "Title": "Pause\nFortsetzen",
          "Tip": "Pausiert den laufenden Druck bzw. setzt ihn fort."
        },
        "cancel": {
          "Title": "Stopp",
          "Tip": "Bricht den laufenden Druck ab (standardmäßig mit Bestätigung durch zweites Tippen)."
        },
        "estop": {
          "Title": "Not-Aus",
          "Tip": "Sendet M112 / Emergency Stop an Klipper (standardmäßig mit Bestätigung durch zweites Tippen)."
        },
        "restart": {
          "Title": "Firmware-Neustart",
          "Tip": "FIRMWARE_RESTART – z. B. nach einem Not-Aus."
        },
        "light": {
          "Title": "Beleuchtung",
          "Tip": "Zeigt, ob die Beleuchtung an ist (output_pin caselight). Einfach tippen: aus, doppelt tippen: an."
        },
        "cooler": {
          "Title": "Polar-Cooler",
          "Tip": "Zeigt, ob der Polar-Cooler an ist (output_pin polar_cooler). Einfach tippen: aus, doppelt tippen: an."
        },
        "box": {
          "Title": "QIDI Box",
          "Tip": "Temperatur und Luftfeuchte der QIDI Box (aht20_f heater_boxN), Trocknungs-Soll. Einfach tippen: Trocknen aus, doppelt tippen: an."
        },
        "gcode": {
          "Title": "G-Code / Makro",
          "Tip": "Sendet eigenen G-Code oder Makros an den Drucker, z. B. Bett vorheizen oder Filament trocknen."
        }
      },
      "UI": {
        "ma45850db2005": "Konfiguration wird geladen…",
        "m5a84048ee669": "Konfiguration konnte nicht geladen werden. Bitte die Einstellungsseite erneut öffnen.",
