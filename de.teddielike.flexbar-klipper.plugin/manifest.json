        "m5e7adf66644d": "Standard (erster Drucker)",
        "m30988b745948": "Beschriftung",
        "mae2087ad82c5": "Beschriftung (leer = keine)",
        "mbbdbb43f8cc0": "Beschriftung (leer = Druckername)",
        "mf3ba90f0852d": "Eigene Beschriftung (leer = Standard)",
        "mfe1aa5426ecd": "Beschriftung auf der Taste",
