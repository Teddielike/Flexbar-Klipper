        "m9e840bdfa41b": "Druckbett",
        "mebd0e866e47c": "Bauraum",
        "mc12fd52b86aa": "Schriftarten für die FlexBar",
        "me83fae29f977": "Kommagetrennte Prioritätsliste. Erste verfügbare Schrift wird genutzt; leer = Schrift der Taste aus FlexDesigner.",
        "m3e305e7fdf7b": "Drucker",
        "mf6cc01cb7edb": "Fehler",
