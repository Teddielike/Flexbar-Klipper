    "en": {
      "PluginName": "Klipper",
      "Keys": {
        "status": {
          "Title": "Printer status",
          "Tip": "Shows the printer state (ready, printing, paused, error, offline)."
        },
        "job": {
          "Title": "Print job",
          "Tip": "Current print: name, progress %, time left, optional ETA, layer and progress bar."
        },
        "jobinfo": {
          "Title": "Print value",
          "Tip": "A single value of the current print: progress, time left, ETA, file name, layer, filament …"
        },
        "hotend": {
          "Title": "Hotend",
          "Tip": "Current and target temperature of the hotend (extruder). Optional: custom G-code for single and double tap."
        },
        "bed": {
          "Title": "Build plate",
          "Tip": "Current and target temperature of the build plate (heater_bed). Optional: custom G-code for single and double tap."
        },
        "chamber": {
          "Title": "Build chamber",
          "Tip": "Build chamber temperature – auto-detected or freely selectable. Optional: custom G-code for single and double tap."
        },
        "sensor": {
          "Title": "Sensor (custom)",
          "Tip": "Any Klipper object or Moonraker sensor, e.g. QIDI Box, humidity sensors, fans, MCU temperature. Optional: custom G-code for single and double tap."
        },
        "pause": {
          "Title": "Pause\nResume",
          "Tip": "Pauses or resumes the current print."
        },
        "cancel": {
          "Title": "Stop",
          "Tip": "Cancels the current print (confirmation by second tap by default)."
        },
        "estop": {
          "Title": "Emergency stop",
          "Tip": "Sends an emergency stop to Klipper (confirmation by second tap by default)."
        },
        "restart": {
          "Title": "Firmware restart",
          "Tip": "FIRMWARE_RESTART – e.g. after an emergency stop."
        },
        "light": {
          "Title": "Case light",
          "Tip": "Shows whether the case light is on (output_pin caselight). Single tap: off, double tap: on."
        },
        "cooler": {
          "Title": "Polar cooler",
          "Tip": "Shows whether the polar cooler is on (output_pin polar_cooler). Single tap: off, double tap: on."
        },
        "box": {
          "Title": "QIDI Box",
          "Tip": "Temperature and humidity of the QIDI Box (aht20_f heater_boxN) and drying target. Single tap: drying off, double tap: on."
        },
        "gcode": {
          "Title": "G-code / macro",
          "Tip": "Sends custom G-code or macros to the printer, e.g. preheat the bed or dry filament."
        }
      },
